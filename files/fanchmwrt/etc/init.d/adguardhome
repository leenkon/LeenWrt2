#!/bin/sh /etc/rc.common
#
# AdGuardHome 启动脚本（官方预编译二进制：以 root 运行绑定 53，复用 /etc/adguardhome/adguardhome.yaml，运行数据 /var/lib/adguardhome）

START=19
STOP=89
USE_PROCD=1

PROG=/usr/bin/AdGuardHome

boot() {
	ADGUARDHOME_BOOT=1
	start "$@"
}

start_service() {
	# 开机阶段延迟启动，等接口 up 再拉起
	[ -n "$ADGUARDHOME_BOOT" ] && return 0

	config_load adguardhome
	local enabled
	config_get_bool enabled config enabled 1
	[ "$enabled" = "1" ] || return 1

	mkdir -m 0700 -p /var/lib/adguardhome

	procd_open_instance adguardhome
	procd_set_param command "$PROG" \
		--config /etc/adguardhome/adguardhome.yaml \
		--work-dir /var/lib/adguardhome \
		--no-check-update \
		--logfile syslog
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance

	# 劫持生命周期绑定 ADGH：仅监听 :53 后才布，停时清表（见 stop_service）
	local dhijack
	config_get_bool dhijack config dns_hijack 1
	if [ "$dhijack" = "1" ] && [ -x /usr/sbin/dns-hijack ]; then
		( local i
		  for i in $(seq 1 20); do
			if ss -lun 2>/dev/null | grep -q ':53 ' || netstat -lun 2>/dev/null | grep -q ':53 '; then
				chmod 755 /usr/sbin/dns-hijack
				/usr/sbin/dns-hijack
				logger -t adguardhome "ADGH 已监听 :53，已布 DNS 劫持"
				break
			fi
			sleep 1
		  done ) &
	fi
}

service_triggers() {
	procd_add_reload_trigger adguardhome
	if [ -n "$ADGUARDHOME_BOOT" ]; then
		# 接口 up 后再真正启动（避开首启网络未就绪）
		procd_add_raw_trigger 'interface.*.up' 5000 /etc/init.d/adguardhome restart
	fi
}

# 停止/卸载时清表，避免重定向到已不存在的 :53 致断网
stop_service() {
	nft delete table inet dns_hijack 2>/dev/null
	logger -t adguardhome "已清除 dns_hijack 规则（回退 DHCP DNS）"
}
