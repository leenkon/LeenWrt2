#!/bin/sh /etc/rc.common
# AdGuardHome 启动脚本（官方预编译二进制）
# 以 root 运行(procd respawn 所需)；ADGH 监听 :5353，dnsmasq 占 :53 兜底。
# 配置 /etc/adguardhome/adguardhome.yaml；运行时数据放 /etc/adguardhome/data(overlay 持久)，
# 勿用 /var/lib/adguardhome——OpenWrt 上 /var 是 /tmp 软链(tmpfs)，重启丢过滤器。
START=19
STOP=89
USE_PROCD=1

PROG=/usr/bin/AdGuardHome

boot() {
	ADGUARDHOME_BOOT=1
	start "$@"
}

# dnsmasq 常驻 :53 兜底：ADGH 宕则清劫持表、LAN 直落 dnsmasq(零抖动)
# 上游自愈+自适应：OC 实际在 :7874 监听才前置走分流（端口 7874=0x1EC2，读 /proc/net/tcp 探活，免 ss/netstat 本机缺失）；
# 仅看 init.d 文件存在会误判——OC 装了没跑→死端口拖慢 dnsmasq 每查询 ~6s。保留构建期上游；全空按拓扑兜底（无上游则全部查询 REFUSED）
setup_dnsmasq() {
	uci -q delete dhcp.@dnsmasq[0].port
	uci set dhcp.@dnsmasq[0].noresolv='1'
	uci set dhcp.@dnsmasq[0].dns_redirect='0'

	# OC 仅在 :7874 真监听时前置；装了未起→不前置(防死端口)
	_oc=""
	[ -x /etc/init.d/openclash ] && grep -qi ':1ec2 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null && _oc='127.0.0.1#7874'
	_tail=""
	for s in $(uci -q get dhcp.@dnsmasq[0].server); do
		# 丢弃陈旧 7874(OC 已停监听) 与即将前置的 7874，仅保留其它上游
		[ "$s" = "127.0.0.1#7874" ] && continue
		_tail="$_tail $s"
	done
	# OC 之外无上游时按拓扑补：有 WAN 直连公网，无 WAN(旁路由) 走 lan 网关
	if [ -z "$_tail" ]; then
		uci -q get network.wan >/dev/null && _tail='223.5.5.5 223.6.6.6' || _tail=$(uci -q get network.lan.gateway)
	fi
	uci -q delete dhcp.@dnsmasq[0].server
	for s in $_oc $_tail; do uci add_list dhcp.@dnsmasq[0].server="$s"; done

	uci commit dhcp
	/etc/init.d/dnsmasq restart 2>/dev/null
}

start_service() {
	# 开机先不启动，等接口 up 再拉起(网络未就绪会解析失败)
	[ -n "$ADGUARDHOME_BOOT" ] && return 0

	config_load adguardhome
	local enabled
	config_get_bool enabled config enabled 1
	[ "$enabled" = "1" ] || return 1

	# 二进制缺失：不抢占 :53，回退 dnsmasq 防断网
	if [ ! -x "$PROG" ]; then
		logger -t adguardhome "AdGuardHome 未安装，回退 dnsmasq :53（不布劫持）"
		setup_dnsmasq
		return 1
	fi

	setup_dnsmasq

	mkdir -m 0700 -p /etc/adguardhome/data

	procd_open_instance adguardhome
	procd_set_param command "$PROG" \
		--config /etc/adguardhome/adguardhome.yaml \
		--work-dir /etc/adguardhome/data \
		--no-check-update \
		--logfile syslog
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance

	# 零抖动监控：ADGH 监听即布表、失联即清表回退 dnsmasq；
	# 顺带探 OC(:7874) 监听态自愈合——OC 起/停时仅状态变化才重排 dnsmasq 上游(防每轮重启抖动)
	local dhijack
	config_get_bool dhijack config dns_hijack 1
	if [ "$dhijack" = "1" ] && [ -x /usr/sbin/dns-hijack ]; then
		pkill -f "/usr/sbin/dns-hijack" 2>/dev/null   # 防重复循环
		(
			_oc_prev=""
			[ -x /etc/init.d/openclash ] && grep -qi ':1ec2 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null && _oc_prev=1
			while true; do
				/usr/sbin/dns-hijack
				# OC 实际在 :7874 监听?
				_oc_now=""
				[ -x /etc/init.d/openclash ] && grep -qi ':1ec2 ' /proc/net/tcp /proc/net/tcp6 2>/dev/null && _oc_now=1
				# 仅监听态变化才重排 dnsmasq 上游(防每轮重启抖动)
				[ "$_oc_now" != "$_oc_prev" ] && { setup_dnsmasq; _oc_prev="$_oc_now"; }
				sleep 5
			done
		) &
	fi
}

# 停止即自愈：停监控 + 清劫持表回退 dnsmasq(零抖动)
stop_service() {
	pkill -f "/usr/sbin/dns-hijack" 2>/dev/null   # 停监控循环及任何残留 dns-hijack 调用
	nft delete table inet dns_hijack 2>/dev/null
	setup_dnsmasq
	logger -t adguardhome "ADGH 停止/卸载：已清除劫持并回退 dnsmasq :53（自愈防断网）"
}

service_triggers() {
	procd_add_reload_trigger adguardhome
	if [ -n "$ADGUARDHOME_BOOT" ]; then
		procd_add_raw_trigger 'interface.*.up' 5000 /etc/init.d/adguardhome restart
	fi
}
