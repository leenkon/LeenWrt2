#!/bin/sh /etc/rc.common
# FanchmWrt 首启在线/离线安装服务
# 等待网络连通后：
#   1) 离线安装 /etc/firstboot-pkgs/apps/*.apk（自编译或本地上传的预编译包，允许未签名；
#      来源需与目标内核 vermagic 匹配，否则 kmod 无法加载）
#   2) 在线安装 lists/ 中的官方源包：common.txt 始终安装；非 Mini 档额外安装 default.txt
#   3) OC/ADGH 首启布链（apply_oc_adgh）：安装后写回自定义文件并应用 DNS 过滤链（main 含 dns-hijack）
# 完成后自禁用并清理本服务，避免每次启动重复安装。
START=99
STOP=10

install_all() {
    # 1) 离线 .apk（自编译包，允许未签名）
    if [ -d /etc/firstboot-pkgs/apps ]; then
        for f in /etc/firstboot-pkgs/apps/*.apk; do
            [ -f "$f" ] || continue
            if apk --allow-untrusted add "$f" >/dev/null 2>&1; then
                rm -f "$f"
            else
                logger -t firstboot-pkgs "离线安装失败(保留待查): $f"
            fi
        done
    fi

    # 2) 在线官方源包（lists 文本：每行一个包名，# 开头为注释）
    #    逐包安装：apk 默认整批原子提交，列表中任一包名缺失/失败会导致整批不装；
    #    曾因列表中某个非核心包在 25.12 源不存在（更名/移除）而整批失败、连 luci 都没装上，
    #    导致进不去后台。改为逐包安装 + 失败仅记录，保证核心包一定装得上。
    local prof pkg_list pkg
    prof=$(cat /etc/firstboot-pkgs/profile 2>/dev/null)
    install_list() {
        [ -f "$1" ] || return 0
        pkg_list=$(grep -v '^#' "$1" | grep -v '^$')
        for pkg in $pkg_list; do
            if apk add "$pkg" >/dev/null 2>&1; then
                logger -t firstboot-pkgs "已安装: $pkg"
            else
                logger -t firstboot-pkgs "安装失败(跳过): $pkg"
            fi
        done
    }
    if ! apk update >/dev/null 2>&1; then
        logger -t firstboot-pkgs "apk update 失败：跳过在线安装（检查 /etc/apk/repositories 与联网）"
    else
        # common 始终安装；Mini 档无专属包（仅 common），Main 档额外安装 default.txt
        install_list /etc/firstboot-pkgs/lists/common.txt
        [ "$prof" != "mini" ] && install_list /etc/firstboot-pkgs/lists/default.txt
    fi

    # OC/ADGH 首启布链：必须在 apk 安装之后（uci schema 才就绪），且在本服务自清理前（staging 仍在）
    apply_oc_adgh "$prof"

    # 安装完成后刷新 Web 后台，加载新装的 luci-app-* 模块（uhttpd 需 restart 才能识别）
    [ -x /etc/init.d/uhttpd ] && /etc/init.d/uhttpd restart 2>/dev/null
    [ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd restart 2>/dev/null

    # 自清理：禁用并删除本服务，避免后续启动重复执行
    /etc/init.d/firstboot-pkgs disable 2>/dev/null
    rm -f /etc/init.d/firstboot-pkgs
    rm -rf /etc/firstboot-pkgs
}

# 首启安装 OC/ADGH 后应用 DNS 过滤链（解决首启时序：uci schema 需包已装）
apply_oc_adgh() {
    local prof="$1"
    # 勾选门控：未勾选时 oc-adgh.txt 不会被拷入镜像，直接跳过（DNS 保持默认，不被劫持）
    [ -f /etc/firstboot-pkgs/lists/oc-adgh.txt ] || return 0

    # apk add 可能覆盖 vendored 的 /etc 文件，故安装后再把 staging 写回真实路径
    if [ -d /etc/firstboot-pkgs/adgh ]; then
        cp -rf /etc/firstboot-pkgs/adgh/etc/* /etc/ 2>/dev/null
        cp -rf /etc/firstboot-pkgs/adgh/usr/* /usr/ 2>/dev/null
    fi

    # OpenClash uci（Meta / redir-host；sniffer 由 custom_overwrite 开启）
    if [ -x /etc/init.d/openclash ] || command -v openclash >/dev/null 2>&1; then
        uci -q get openclash.config.core_type >/dev/null || uci set openclash.config=openclash
        uci set openclash.config.core_type='Meta'
        uci set openclash.config.core_version='linux-amd64'
        uci set openclash.config.enable_redirect_dns='0'
        uci set openclash.config.en_mode='redir-host'
        uci set openclash.config.operation_mode='redir-host'
        uci set openclash.config.enable_custom_overwrite='1'
        uci commit openclash
        /etc/init.d/openclash enable 2>/dev/null
        logger -t firstboot-pkgs "OpenClash 已配置并启用"
    fi

    # AdGuardHome 启用 + 启动（自定义 init.d 以 root 运行绑定 :53）
    if [ -x /etc/init.d/adguardhome ]; then
        uci set adguardhome.config.enabled='1' 2>/dev/null
        /etc/init.d/adguardhome enable 2>/dev/null
        /etc/init.d/adguardhome start 2>/dev/null
        logger -t firstboot-pkgs "AdGuardHome 已启用并启动"
    fi

    # DNS 拓扑：仅当 OC/ADGH 实际装上才布链（避免未安装时劫持 DNS 致断网）
    if [ -x /etc/init.d/adguardhome ] || [ -x /etc/init.d/openclash ]; then
        # dnsmasq 让出 :53 给 ADGH；OC 监听 :7874 为 ADGH 主上游
        if [ "$prof" = "mini" ]; then
            # 旁路由：dnsmasq :5453（DHCP ignore 由 99-custom 设置），ADGH :53，OC :7874；无 dns-hijack
            uci -q set dhcp.@dnsmasq[0].port='5453'
            uci -q set dhcp.@dnsmasq[0].rebind_protection='0'
            uci -q set dhcp.@dnsmasq[0].dns_redirect='0'
            uci -q delete dhcp.@dnsmasq[0].server
            uci add_list dhcp.@dnsmasq[0].server='223.5.5.5'
            uci add_list dhcp.@dnsmasq[0].server='223.6.6.6'
            uci set dhcp.@dnsmasq[0].noresolv='1'
            uci commit dhcp
            logger -t firstboot-pkgs "旁路由 DNS 拓扑: dnsmasq :5453 -> ADGH :53 -> OC :7874（无 dns-hijack）"
        else
            # 主路由：dnsmasq :5453，ADGH :53，OC :7874，dns-hijack 劫持 LAN :53 -> ADGH
            uci -q set dhcp.@dnsmasq[0].port='5453'
            uci -q delete dhcp.@dnsmasq[0].server
            uci add_list dhcp.@dnsmasq[0].server='223.5.5.5'
            uci add_list dhcp.@dnsmasq[0].server='223.6.6.6'
            uci set dhcp.@dnsmasq[0].noresolv='1'
            uci set dhcp.@dnsmasq[0].dns_redirect='0'
            uci commit dhcp
            if [ -x /usr/sbin/dns-hijack ]; then
                chmod 755 /usr/sbin/dns-hijack
                /usr/sbin/dns-hijack
                uci -q delete firewall.dns_hijack_include
                uci set firewall.dns_hijack_include=include
                uci set firewall.dns_hijack_include.path='/usr/sbin/dns-hijack'
                uci set firewall.dns_hijack_include.enabled='1'
                uci commit firewall
                logger -t firstboot-pkgs "主路由 DNS 拓扑: dnsmasq :5453 -> ADGH :53 -> OC :7874 + dns-hijack"
            fi
        fi
    fi
}

wait_net() {
    # 等待到公网可达（不依赖具体接口，旁路由无 wan 也能靠网关路由出去）
    local i=0
    while [ $i -lt 30 ]; do
        if ping -c1 -W2 223.5.5.5 >/dev/null 2>&1; then
            return 0
        fi
        i=$((i + 1))
        sleep 4
    done
    return 1
}

start() {
    # 后台执行，避免阻塞系统启动；网络就绪才安装并清理，否则保留服务下次启动重试
    (
        if wait_net; then
            install_all
        else
            logger -t firstboot-pkgs "等待网络超时，保留服务下次启动重试"
        fi
    ) &
}

stop() { :; }
