#!/bin/sh
# 主路由 nftables DNS 劫持：重定向 LAN 出向 :53 到本机 ADGH(:53)，排除旁路由 IP
# 运行期自愈：ADGH 未安装/未监听 :53 则不劫持，回退 DHCP DNS 防断网
nft delete table inet dns_hijack 2>/dev/null
command -v nft >/dev/null 2>&1 || { logger -t dns-hijack "nft 不存在，跳过"; exit 0; }

# ADGH 未安装则不劫持
if [ ! -x /usr/bin/AdGuardHome ]; then
    logger -t dns-hijack "AdGuardHome 未安装，跳过劫持（回退 DHCP DNS）"
    exit 0
fi
# 进程未监听 :53 同样跳过，避免重定向到空端口
port_listen() {
    if command -v ss >/dev/null 2>&1; then
        ss -lun 2>/dev/null | grep -q ':53 '
    elif command -v netstat >/dev/null 2>&1; then
        netstat -lun 2>/dev/null | grep -q ':53 '
    else
        return 1
    fi
}
if ! port_listen; then
    logger -t dns-hijack "AdGuardHome 未在监听 :53，跳过劫持（回退 DHCP DNS）"
    exit 0
fi

# 旁路由 IP：由 LAN 口 IP 推导同网段 .2
BYPASS_IP=$(uci -q get network.lan.ipaddr 2>/dev/null | sed 's/\.[0-9]*$/.2/')

nft add table inet dns_hijack
nft add chain inet dns_hijack prerouting '{ type nat hook prerouting priority -100; }'

if [ -n "$BYPASS_IP" ]; then
    nft add rule inet dns_hijack prerouting ip saddr != $BYPASS_IP udp dport 53 redirect to :53
    nft add rule inet dns_hijack prerouting ip saddr != $BYPASS_IP tcp dport 53 redirect to :53
    logger -t dns-hijack "DNS 劫持已应用（排除旁路由 $BYPASS_IP）"
else
    nft add rule inet dns_hijack prerouting udp dport 53 redirect to :53
    nft add rule inet dns_hijack prerouting tcp dport 53 redirect to :53
    logger -t dns-hijack "DNS 劫持已应用（全 LAN，未识别旁路由）"
fi
